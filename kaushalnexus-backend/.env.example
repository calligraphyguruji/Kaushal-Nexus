# ==============================================================================
# KaushalNexus Backend Environment Variables Template
# Copy this file to .env and configure values before starting the application.
# NEVER commit raw .env files with real production secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Settings
# ------------------------------------------------------------------------------
APP_NAME=KaushalNexus Backend API
APP_ENV=development
APP_DEBUG=true
API_V1_STR=/api/v1

# ------------------------------------------------------------------------------
# 2. Cryptography & JWT Security
# ------------------------------------------------------------------------------
# In production, generate a secure 64-character secret: `openssl rand -hex 32`
SECRET_KEY=change-this-to-a-super-secret-hex-key-in-production-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ------------------------------------------------------------------------------
# 3. Rate Limiting (DDoS & Brute-force Prevention)
# ------------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_PER_MINUTE=300
RATE_LIMIT_AUTH_PER_MINUTE=100

# ------------------------------------------------------------------------------
# 4. Server Configuration
# ------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
WORKERS=2
RUN_MIGRATIONS=true

# ------------------------------------------------------------------------------
# 5. CORS Allowed Origins (Comma-separated)
# ------------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# 6. PostgreSQL Database (asyncpg connection pool)
# ------------------------------------------------------------------------------
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=kaushal_admin
POSTGRES_PASSWORD=kaushal_secret
POSTGRES_DB=kaushalnexus_db
POSTGRES_HOST_PORT=5432
DATABASE_URL=postgresql+asyncpg://kaushal_admin:kaushal_secret@localhost:5432/kaushalnexus_db

# Connection Pool Tuning
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# ------------------------------------------------------------------------------
# 7. Redis & Celery Background Task Broker
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_HOST_PORT=6379
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_CONCURRENCY=4

# ------------------------------------------------------------------------------
# 8. External Integrations (Mock Adapters)
# ------------------------------------------------------------------------------
UIDAI_AADHAAR_MOCK=true
EPFO_SERVICE_MOCK=true
SID_REGISTRY_MOCK=true
INTEGRATION_TIMEOUT_SECONDS=5
INTEGRATION_MAX_RETRIES=3

# ------------------------------------------------------------------------------
# 9. NPMAI Ecosystem Configuration (pip install npmai)
# ------------------------------------------------------------------------------
# Models supported: llama3.2, mistral, gemma2, phi3, qwen2.5, deepseek-r1, vicuna:7b, etc.
NPMAI_MODEL=llama3.2
NPMAI_TEMPERATURE=0.3
NPMAI_AUTO_FALLBACK=true
NPMAI_TIMEOUT_SECONDS=15.0

# ------------------------------------------------------------------------------
# 10. Google Gemini AI Integration (Google AI Studio)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
GEMINI_API_TIMEOUT_SECONDS=30.0

# ------------------------------------------------------------------------------
# 11. Structured Logging
# ------------------------------------------------------------------------------
LOG_LEVEL=INFO


