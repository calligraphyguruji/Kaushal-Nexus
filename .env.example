# ==============================================================================
# KaushalNexus Platform Environment Variables Example
# ==============================================================================

# Backend API URL for React Frontend (Vite)
VITE_API_URL=http://localhost:8000/api/v1

# Backend Server Environment Variables (Configure in kaushalnexus-backend/.env)
# ------------------------------------------------------------------------------
# NPMAI Python AI Ecosystem (pip install npmai)
# Models supported: llama3.2, mistral, gemma2, phi3, qwen2.5, deepseek-r1, vicuna:7b, etc.
NPMAI_MODEL=llama3.2
NPMAI_TEMPERATURE=0.3
NPMAI_AUTO_FALLBACK=true
NPMAI_TIMEOUT_SECONDS=15.0

# Google Gemini AI Integration (Google AI Studio)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
GEMINI_API_TIMEOUT_SECONDS=30.0

# Database & Redis
DATABASE_URL=postgresql+asyncpg://kaushal_admin:kaushal_secret@localhost:5432/kaushalnexus_db
REDIS_URL=redis://localhost:6379/0
